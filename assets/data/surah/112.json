{
  "nomor": 112,
  "nama": "Al-Ikhlas",
  "jumlah_ayat": 4,
  "ayat": [
    {
      "nomor": 0,
      "arab": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
      "arti": "Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang."
    },
    {
      "nomor": 1,
      "arab": "قُلْ هُوَ اللّٰهُ اَحَدٌۚ",
      "arti": "Katakanlah (Muhammad), “Dialah Allah, Yang Maha Esa."
    },
    {
      "nomor": 2,
      "arab": "اَللّٰهُ الصَّمَدُۚ",
      "arti": "Allah tempat meminta segala sesuatu."
    },
    {
      "nomor": 3,
      "arab": "لَمْ يَلِدْ وَلَمْ يُوْلَدْۙ",
      "arti": "(Allah) tidak beranak dan tidak pula diperanakkan."
    },
    {
      "nomor": 4,
      "arab": "وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ࣖ",
      "arti": "Dan tidak ada sesuatu yang setara dengan Dia.”"
    }
  ]
}