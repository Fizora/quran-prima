{
  "nomor": 94,
  "nama": "Asy-Syarh",
  "jumlah_ayat": 8,
  "ayat": [
    {
      "nomor": 0,
      "arab": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ",
      "arti": "Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang."
    },
    {
      "nomor": 1,
      "arab": "اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ",
      "arti": "Bukankah Kami telah melapangkan dadamu (Muhammad)?"
    },
    {
      "nomor": 2,
      "arab": "وَوَضَعْنَا عَنْكَ وِزْرَكَۙ",
      "arti": "dan Kami pun telah menurunkan bebanmu darimu,"
    },
    {
      "nomor": 3,
      "arab": "الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ",
      "arti": "yang memberatkan punggungmu, "
    },
    {
      "nomor": 4,
      "arab": "وَرَفَعْنَا لَكَ ذِكْرَكَۗ",
      "arti": "dan Kami tinggikan sebutan (nama)mu bagimu."
    },
    {
      "nomor": 5,
      "arab": "فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ",
      "arti": "Maka sesungguhnya beserta kesulitan ada kemudahan,"
    },
    {
      "nomor": 6,
      "arab": "اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ",
      "arti": "sesungguhnya beserta kesulitan itu ada kemudahan."
    },
    {
      "nomor": 7,
      "arab": "فَاِذَا فَرَغْتَ فَانْصَبْۙ",
      "arti": "Maka apabila engkau telah selesai (dari sesuatu urusan), tetaplah bekerja keras (untuk urusan yang lain),"
    },
    {
      "nomor": 8,
      "arab": "وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ",
      "arti": "dan hanya kepada Tuhanmulah engkau berharap."
    }
  ]
}