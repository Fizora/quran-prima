{
  "nomor": 101,
  "nama": "Al-Qari'ah",
  "ayat": [
    {
      "nomor": 0,
      "arab": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
      "arti": "Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang."
    },
    {
      "nomor": 1,
      "arab": "اَلْقَارِعَةُۙ",
      "arti": "Hari Kiamat,"
    },
    {
      "nomor": 2,
      "arab": "مَا الْقَارِعَةُ ۚ",
      "arti": "Apakah hari Kiamat itu?"
    },
    {
      "nomor": 3,
      "arab": "وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ",
      "arti": "Dan tahukah kamu apakah hari Kiamat itu?"
    },
    {
      "nomor": 4,
      "arab": "يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ",
      "arti": "Pada hari itu manusia seperti laron yang beterbangan,"
    },
    {
      "nomor": 5,
      "arab": "وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ",
      "arti": "dan gunung-gunung seperti bulu yang dihambur-hamburkan."
    },
    {
      "nomor": 6,
      "arab": "فَاَمَّا مَنْ ثَقُلَتْ مَوَازِينُهٗۙ",
      "arti": "Maka adapun orang yang berat timbangan (kebaikan)nya,"
    },
    {
      "nomor": 7,
      "arab": "فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ",
      "arti": "maka dia berada dalam kehidupan yang memuaskan (senang)."
    },
    {
      "nomor": 8,
      "arab": "وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ",
      "arti": "Dan adapun orang yang ringan timbangan (kebaikan)nya,"
    },
    {
      "nomor": 9,
      "arab": "فَاُمُّهُ هَاوِيَةٌ  ۗ",
      "arti": "maka tempat kembalinya adalah neraka Hawiyah."
    },
    {
      "nomor": 10,
      "arab": "وَمَآ اَدْرٰىكَ مَا هِيَهْۗ",
      "arti": "Dan tahukah kamu apakah neraka Hawiyah itu?"
    },
    {
      "nomor": 11,
      "arab": "نَارٌ حَامِيَةٌ ࣖ",
      "arti": "(Yaitu) api yang sangat panas."
    }
  ]
}