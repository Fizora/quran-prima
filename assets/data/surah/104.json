{
  "nomor": 104,
  "nama": "Al-Humazah",
  "jumlah_ayat": 9,
  "ayat": [
    {
      "nomor": 0,
      "arab": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ",
      "arti": "Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang."
    },
    {
      "nomor": 1,
      "arab": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ",
      "arti": "Celakalah bagi setiap pengumpat dan pencela,"
    },
    {
      "nomor": 2,
      "arab": " ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ",
      "arti": "yang mengumpulkan harta dan menghitung-hitungnya,"
    },
    {
      "nomor": 3,
      "arab": "يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ",
      "arti": "dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya."
    },
    {
      "nomor": 4,
      "arab": "كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ",
      "arti": "Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah."
    },
    {
      "nomor": 5,
      "arab": "وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ",
      "arti": "Dan tahukah kamu apakah (neraka) Hutamah itu?"
    },
    {
      "nomor": 6,
      "arab": "نَارُ اللّٰهِ الْمُوْقَدَةُۙ",
      "arti": "(Yaitu) api  (azab) Allah yang dinyalakan,"
    },
    {
      "nomor": 7,
      "arab": "الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ",
      "arti": "yang (membakar) sampai ke hati."
    },
    {
      "nomor": 8,
      "arab": "اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ",
      "arti": "Sungguh, api itu ditutup rapat atas (diri) mereka,"
    },
    {
      "nomor": 9,
      "arab": "فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ",
      "arti": "(sedang mereka itu) diikat pada tiang-tiang yang panjang."
    }
  ]
}