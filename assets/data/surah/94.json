{
  "nomor": 94,
  "nama": "Al-Insyirah",
  "ayat": [
    {
      "nomor": 1,
      "arab": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "arti": "Bukankah Kami telah melapangkan untukmu dadamu (Muhammad)?"
    },
    {
      "nomor": 2,
      "arab": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "arti": "Dan Kami pun telah menurunkan bebanmu darimu,"
    },
    {
      "nomor": 3,
      "arab": "الَّذِي أَنقَضَ ظَهْرَكَ",
      "arti": "yang memberatkan punggungmu."
    },
    {
      "nomor": 4,
      "arab": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "arti": "Dan Kami tinggikan sebutan (nama)mu untukmu."
    },
    {
      "nomor": 5,
      "arab": "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا",
      "arti": "Maka sesungguhnya beserta kesulitan ada kemudahan,"
    },
    {
      "nomor": 6,
      "arab": "إِنَّ مَعَ الْعُسْرِ يُسْرًا",
      "arti": "sesungguhnya beserta kesulitan ada kemudahan."
    },
    {
      "nomor": 7,
      "arab": "فَإِذَا فَرَغْتَ فَانصَبْ",
      "arti": "Maka apabila engkau telah selesai (dari sesuatu urusan), tetaplah bekerja keras (untuk urusan yang lain),"
    },
    {
      "nomor": 8,
      "arab": "وَإِلَىٰ رَبِّكَ فَارْغَبْ",
      "arti": "dan hanya kepada Tuhanmulah engkau berharap."
    }
  ]
}
