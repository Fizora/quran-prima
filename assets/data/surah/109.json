{
  "nomor": 109,
  "nama": "Al-Kafirun",
  "jumlah_ayat": 6,
  "ayat": [
    {
      "nomor": 0,
      "arab": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ",
      "arti": "Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang."
    },
    {
      "nomor": 1,
      "arab": "قُلْ يٰٓاَيُّهَا الْكٰفِرُوْنَۙ",
      "arti": "Katakanlah (Muhammad), “Wahai orang-orang kafir!"
    },
    {
      "nomor": 2,
      "arab": "لَآ اَعْبُدُ مَا تَعْبُدُوْنَۙ",
      "arti": "aku tidak akan menyembah apa yang kamu sembah,"
    },
    {
      "nomor": 3,
      "arab": "وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۚ",
      "arti": "dan kamu bukan penyembah apa yang aku sembah,"
    },
    {
      "nomor": 4,
      "arab": "وَلَآ اَنَا۠ عَابِدٌ مَّا عَبَدْتُّمْۙ",
      "arti": "dan aku tidak pernah menjadi penyembah apa yang kamu sembah,"
    },
    {
      "nomor": 5,
      "arab": "وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۗ",
      "arti": "dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah."
    },
    {
      "nomor": 6,
      "arab": "لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ࣖ",
      "arti": "Untukmu agamamu, dan untukku agamaku.”"
    }
  ]
}