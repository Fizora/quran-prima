{
  "nomor": 114,
  "nama": "An-Nas",
  "jumlah_ayat": 6,
  "ayat": [
    {
      "nomor": 0,
      "arab": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ",
      "arti": "Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang."
    },
    {
      "nomor": 1,
      "arab": "قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ",
      "arti": "Katakanlah, “Aku berlindung kepada Tuhannya manusia,"
    },
    {
      "nomor": 2,
      "arab": "مَلِكِ النَّاسِۙ",
      "arti": "Raja manusia,"
    },
    {
      "nomor": 3,
      "arab": "اِلٰهِ النَّاسِۙ",
      "arti": "sembahan manusia,"
    },
    {
      "nomor": 4,
      "arab": "مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ",
      "arti": "dari kejahatan (bisikan) setan yang bersembunyi,"
    },
    {
      "nomor": 5,
      "arab": "الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ",
      "arti": "yang membisikkan (kejahatan) ke dalam dada manusia,"
    },
    {
      "nomor": 6,
      "arab": "مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ ",
      "arti": "dari (golongan) jin dan manusia.”"
    }
  ]
}